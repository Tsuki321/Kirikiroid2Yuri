function ciErrorText(error) {
    try { if (error.message !== void) return "" + error.message; } catch (ignored) {}
    return "" + error;
}
var ciMessages = [];
function ciCheck(value, message) {
    if (!value) throw "CI assertion: " + message;
    ciMessages.add("PASS " + message);
    ciMessages.save(ciOutput + "progress.txt");
}
function ciThrows(operation, message) {
    var rejected = false;
    try { operation(); } catch (error) { rejected = true; }
    ciCheck(rejected, message);
}
var ciStorage = "@@STORAGE@@/";
var ciOutput = "@@OUTPUT@@/";
// Class callbacks and separately loaded fixtures resolve these as globals.
var ciWindow = void;
var ciLayer = void;
ciMessages.add("ENGINE_CI_STARTED");
ciMessages.save(ciOutput + "started.txt");
try {
    ciCheck(System.getArgument("-ci-launch") === "kept", "launch arguments survive engine initialization");
    ciCheck(System.getArgument("-ci-preference") === "saved value=1 & 2",
        "game folder preferences supply literal engine arguments");
    ciCheck(System.getArgument("-ci-zero") === "0" && System.getArgument("-ci-flag") === "yes"
        && System.getArgument("-ci-empty") === "" && System.getArgument("-ci-equals") === "left=right",
        "launch arguments preserve zero, flags, empty values, and equals signs");
    ciCheck(System.getArgument("-ci-duplicate") === "new" && System.getArgument("-ci-missing") === void,
        "launch argument replacement and missing values");
    System.setArgument("-ci-launch", "changed");
    ciCheck(System.getArgument("-ci-launch") === "changed", "script can update a launch argument");
    if (typeof global.ciColdCompiledStartup != "undefined")
        ciCheck(global.ciColdCompiledStartup === 1, "cold compiled startup preserves bootstrap globals");
    ciCheck("%d:%s".sprintf(42, "ok") == "42:ok", "formatted string arguments");
    var ciEmpty = "";
    ciCheck(ciEmpty.length == 0 && ciEmpty[0] == "" && (int ciEmpty) == 0
        && (real ciEmpty) == 0 && (+ciEmpty) == 0, "empty-string access and numeric conversions");
    var ciEmptyLines = ["", "value", ""];
    ciEmptyLines.save(ciStorage + "empty-lines.txt");
    var ciLoadedLines = [];
    ciLoadedLines.load(ciStorage + "empty-lines.txt");
    ciCheck(ciLoadedLines.count == 3 && ciLoadedLines[0] == "" && ciLoadedLines[2] == "",
        "empty lines survive text save/load");
    var value = %["answer" => 42, "text" => "fixture", "empty" => "", "nested" => [1, 2, 3]];
    (Dictionary.saveStruct incontextof value)(ciStorage + "text-save.tjs");
    var loaded = Dictionary.loadStruct(ciStorage + "text-save.tjs");
    ciCheck(loaded.answer == 42 && loaded.text == "fixture" && loaded.empty == "" && loaded.nested[2] == 3, "text save/load");
    (Dictionary.saveStruct incontextof value)(ciStorage + "binary-save.tjs", "b");
    loaded = Dictionary.loadStruct(ciStorage + "binary-save.tjs");
    ciCheck(loaded.answer == 42 && loaded.nested.count == 3, "binary save/load");
    (Dictionary.saveStruct incontextof value)(ciStorage + "compressed-save.tjs", "z");
    loaded = Dictionary.loadStruct(ciStorage + "compressed-save.tjs");
    ciCheck(loaded.answer == 42, "compressed text save/load");
    if (ciStorage.indexOf("/documents/") == 0) {
        var fullRejected = false;
        try { (Dictionary.saveStruct incontextof value)(ciStorage + "full.dat", "z"); } catch (error) { fullRejected = true; }
        ciCheck(fullRejected, "disk-full at close is catchable");
    }
    Plugins.link("scriptsEx.dll");
    var ciPluginCount = Plugins.getList().count;
    Plugins.link("scriptsEx.dll");
    Plugins.link("C:\\game\\plugin\\ScRiPtSeX.DlL");
    Plugins.link("plugin/scriptsEx.tpm");
    Plugins.link("data.xp3>plugin/SCRIPTSEX.TPM");
    ciCheck(Plugins.getList().count == ciPluginCount, "plugin paths and DLL/TPM aliases share one registration");
    ciCheck(!Plugins.unlink("plugin/ScRiPtSeX.TPM"), "resident plugin refuses unloading while its APIs remain available");
    ciCheck(Plugins.getList().count == ciPluginCount, "refused unload preserves registered modules");
    var rejected = false;
    try { Plugins.link("ci-missing-plugin.dll"); } catch (error) { rejected = true; }
    ciCheck(rejected, "missing plugin reported");
    ciThrows(function() { Plugins.link(""); }, "empty plugin name rejected");
    ciThrows(function() { Plugins.unlink("ci-missing-plugin.dll"); }, "unloading an unknown plugin rejected");
    ciCheck(Plugins.getList().count == ciPluginCount, "failed plugin links do not change the loaded list");
    Scripts.execStorage(ciStorage + "plugin-tests.tjs");
    global.ciCompiled = 0;
    Scripts.compileStorage(ciStorage + "compiled-source.tjs", ciStorage + "compiled.tjb");
    Scripts.execStorage(ciStorage + "compiled.tjb");
    ciCheck(global.ciCompiled == 42, "compile/load bytecode");
    rejected = false;
    try { Scripts.execStorage(ciStorage + "broken.tjb"); } catch (error) { rejected = true; }
    ciCheck(rejected, "truncated bytecode rejected");
    global.ciSideEffect = 0;
    rejected = false;
    try { Dictionary.loadStruct(ciStorage + "unsafe.txt"); } catch (error) { rejected = true; }
    ciCheck(rejected && global.ciSideEffect == 0, "structured data does not execute code");
    rejected = false;
    try { Dictionary.loadStruct(ciStorage + "preprocessor.txt"); } catch (error) { rejected = true; }
    ciCheck(rejected, "structured data rejects preprocessor directives");
    Plugins.link("fstat.dll");
    var ciDir = ciStorage + "directory-test/";
    ciCheck(Storages.createDirectory(ciDir + "child/"), "create a nested storage directory");
    ciCheck(Storages.isExistentDirectory(ciDir), "directory existence works through storage backend");
    ciCheck(Storages.dirlist(ciDir).join(",") == "child/", "directory entries include a trailing slash");
    ciCheck(getDirList(ciDir).join(",") == "child/", "legacy getDirList shares directory semantics");
    var ciDirectoryText = ["portable storage"];
    ciDirectoryText.save(ciDir + "child/original.txt", "utf-8");
    ciCheck(!Storages.removeDirectory(ciDir + "child/") && !Storages.deleteFile(ciDir + "child/"),
        "file and directory removal preserve nonempty directories");
    ciCheck(!Storages.removeDirectory(ciDir + "child/original.txt"), "directory removal rejects files");
    ciCheck(Storages.copyFile(ciDir + "child/original.txt", ciDir + "copy.txt", true), "copy a storage file");
    ciCheck(!Storages.copyFile(ciDir + "child/original.txt", ciDir + "copy.txt", true), "copy honors fail-if-exists");
    ciCheck(!Storages.copyFile(ciDir + "copy.txt", ciDir + "copy.txt"), "copy rejects identical source and destination");
    var ciStat = Storages.fstat(ciDir + "copy.txt");
    ciCheck(ciStat.size > 0 && ciStat.mtime.getTime() > 0, "file size and Date timestamp are returned");
    ciCheck(Storages.dirtree(ciDir, true).join(",") == "child/", "recursive directory-only listing");
    ciCheck(Storages.dirtree(ciDir).join(",") == "child/,child/original.txt,copy.txt", "recursive relative file paths");
    ciCheck(Storages.moveFile(ciDir + "copy.txt", ciDir + "moved.txt"), "move a storage file");
    ciCheck(Storages.deleteFile(ciDir + "moved.txt") && Storages.deleteFile(ciDir + "child/original.txt"), "delete storage files");
    ciCheck(Storages.removeDirectory(ciDir + "child/") && Storages.removeDirectory(ciDir), "remove empty storage directories");
    ciCheck(!Storages.isExistentDirectory(ciDir), "removed directories are absent");
    Plugins.link("layerExDraw.dll");
    Plugins.link("layerExImage.dll");
    Plugins.link("windowEx.dll");
    ciWindow = new Window();
    ciWindow.setSize(320, 240);
    var ciPrimary = new Layer(ciWindow, null);
    ciPrimary.setSize(320, 240);
    ciLayer = new Layer(ciWindow, ciPrimary);
    ciLayer.setSize(320, 240);
    ciLayer.imageWidth = 320;
    ciLayer.imageHeight = 240;
    ciLayer.type = ltAlpha;
    ciWindow.visible = true;
    ciLayer.clear(0);
    ciLayer.setMainPixel(1, 1, 0x123456);
    ciCheck(ciLayer.getMainPixel(1, 1) == 0x123456, "pixel color read/write");
    ciLayer.clear(0);
    var ciBrush = new GdiPlus.Appearance();
    ciBrush.addBrush(0xff336699);
    var ciDrawBounds = ciLayer.drawRectangle(ciBrush, 10, 10, 30, 20);
    var ciDrawPixel = ciLayer.getMainPixel(15, 15) & 0xffffff;
    ciMessages.add("Rectangle bounds " + ciDrawBounds.x + "," + ciDrawBounds.y + "," + ciDrawBounds.width + "," + ciDrawBounds.height
        + " pixel=" + ciDrawPixel + " mask=" + ciLayer.getMaskPixel(15, 15));
    ciMessages.save(ciOutput + "progress.txt");
    ciCheck(ciDrawPixel == 0x336699, "rectangle paints correct pixels (actual " + ciDrawPixel + ")");
    ciCheck(ciLayer.getMaskPixel(8, 8) == 0 && ciLayer.getMainPixel(8, 8) == 0,
        "transparent lanes beside the rectangle remain unchanged");
    ciLayer.setTransform([1, 0, 0, 1, 50, 0]);
    ciLayer.drawRectangle(ciBrush, 10, 10, 30, 20);
    ciLayer.resetTransform();
    ciCheck((ciLayer.getMainPixel(65, 15) & 0xffffff) == 0x336699, "drawing transform");
    ciLayer.drawRectangle(ciBrush, 10, 10, 30, 20);
    ciCheck(ciLayer.getMainPixel(15, 15) == 0x336699 && ciLayer.getMaskPixel(15, 15) == 255,
        "repeated opaque drawing preserves color and alpha");
    var ciHalfRed = new GdiPlus.Appearance();
    ciHalfRed.addBrush(0x80ff0000);
    ciLayer.drawRectangle(ciHalfRed, 200, 10, 10, 10);
    ciCheck(ciLayer.getMainPixel(205, 15) == 0xff0000 && ciLayer.getMaskPixel(205, 15) == 128,
        "translucent drawing onto transparent pixels preserves straight color");
    var ciBlue = new GdiPlus.Appearance();
    ciBlue.addBrush(0xff0000ff);
    ciLayer.drawRectangle(ciBlue, 220, 10, 10, 10);
    ciLayer.drawRectangle(ciHalfRed, 220, 10, 10, 10);
    var ciMixed = ciLayer.getMainPixel(225, 15);
    ciCheck(((ciMixed >> 16) & 255) >= 127 && ((ciMixed >> 16) & 255) <= 129
        && (ciMixed & 255) >= 126 && (ciMixed & 255) <= 128
        && (ciMixed & 0xff00) == 0 && ciLayer.getMaskPixel(225, 15) == 255,
        "translucent drawing blends with an opaque destination");
    var ciTransparent = new GdiPlus.Appearance();
    ciTransparent.addBrush(0x00336699);
    ciLayer.drawRectangle(ciTransparent, 220, 10, 10, 10);
    ciCheck(ciLayer.getMainPixel(225, 15) == ciMixed && ciLayer.getMaskPixel(225, 15) == 255,
        "transparent drawing preserves destination pixels");
    var ciFont = new GdiPlus.Font("sans-serif", 16, GdiPlus.FontStyleRegular);
    var smallMetric = ciFont.lineSpacing;
    ciFont.emSize = 24;
    ciCheck(ciFont.ascent > 0 && ciFont.lineSpacing > smallMetric, "font metrics update");
    ciLayer.drawString(ciFont, ciBrush, 5, 100, "Hello");
    var ciTextPixels = 0;
    for (var ciY = 100; ciY < 135; ++ciY)
        for (var ciX = 5; ciX < 100; ++ciX)
            if (ciLayer.getMaskPixel(ciX, ciY) > 0) ++ciTextPixels;
    ciCheck(ciTextPixels > 20, "text rasterizes visible glyphs");
    var ciPath = new GdiPlus.Path();
    ciPath.drawEllipse(120, 10, 30, 30);
    ciLayer.drawPath(ciBrush, ciPath);
    ciCheck((ciLayer.getMainPixel(135, 25) & 0xffffff) == 0x336699, "path rendering");
    ciLayer.saveImage(ciStorage + "drawing.png", "image/png");
    var ciImage = new GdiPlus.Image(ciStorage + "drawing.png");
    ciCheck(ciImage.width == 320 && ciImage.height == 240, "image encode/decode");
    ciLayer.clear(0);
    ciLayer.drawImage(0, 0, ciImage);
    ciCheck((ciLayer.getMainPixel(15, 15) & 0xffffff) == 0x336699, "image drawing");
    ciLayer.clear(0xff204060);
    ciLayer.setClip(10, 10, 4, 4);
    ciLayer.light(16, 0);
    ciCheck((ciLayer.getMainPixel(11, 11) & 0xffffff) == 0x305070, "image brightness preserves color channel order");
    ciCheck((ciLayer.getMainPixel(9, 11) & 0xffffff) == 0x204060, "image effects respect clipping");
    ciLayer.modulate(0, -100, 0);
    ciCheck((ciLayer.getMainPixel(11, 11) & 0xffffff) == 0x505050, "image desaturation");
    ciLayer.colorize(0, 255, 1);
    ciCheck((ciLayer.getMainPixel(11, 11) & 0xffffff) == 0xa00000, "image colorization");
    ciLayer.gaussianBlur(2);
    ciCheck((ciLayer.getMainPixel(11, 11) & 0xffffff) == 0xa00000, "blur preserves a constant clipped region");
    ciLayer.noise(0);
    ciCheck((ciLayer.getMainPixel(11, 11) & 0xffffff) == 0xa00000, "zero noise preserves pixels");
    ciLayer.generateWhiteNoise();
    var ciNoisePixel = ciLayer.getMainPixel(11, 11);
    ciCheck((ciNoisePixel & 255) == ((ciNoisePixel >> 16) & 255), "white noise is grayscale");
    ciLayer.setClip();
    Plugins.link("textrender.dll");
    class CiTextLayout extends TextRenderBase {
        function CiTextLayout() { super.TextRenderBase(); }
        function onFontChange(info) { ciLayer.font.bold = info.bold; ciLayer.font.italic = info.italic; }
        function onGetTextWidth(text, size) { ciLayer.font.height = size; return ciLayer.font.getTextWidth(text); }
    }
    var ciLayout = new CiTextLayout();
    ciLayout.defaultFontSize = 20;
    ciLayout.clear(); ciLayout.setRenderSize(280, 120);
    ciLayout.render("%lcontinue;[read]A%b1B%b0%l; C");
    var ciGlyphs = ciLayout.getCharacters();
    ciCheck(ciGlyphs.count == 4 && ciGlyphs[0].cw > 0 && ciGlyphs[1].bold, "text layout uses Font callbacks and style controls");
    ciCheck(ciGlyphs[0].ruby[0].text == "read" && ciLayout.renderTop < 0, "text ruby has separate drawing geometry");
    var ciLinks = ciLayout.getLinkRects("continue");
    ciCheck(ciLinks.count == 1 && ciLayout.isLinkContains("continue", ciLinks[0].left + 1, ciLinks[0].top + 1), "text link rectangles support hit testing");
    ciLayer.clear(0xff202020);
    for (var ciGlyph = 0; ciGlyph < ciGlyphs.count; ++ciGlyph) {
        var ciCh = ciGlyphs[ciGlyph];
        ciLayer.font.height = ciCh.size;
        ciLayer.font.bold = ciCh.bold;
        ciLayer.drawText(10 + ciCh.x, 30 + ciCh.y, ciCh.text, 0xffffff);
    }
    ciCheck(ciLayout.renderCount == 4 && ciLayout.renderRight > 0, "text layout can drive Layer drawing");
    Scripts.execStorage(ciStorage + "psb-tests.tjs");
    Scripts.execStorage(ciStorage + "datapack-tests.tjs");

    // Cross TLG5 scanlines and TLG6 block/tail boundaries with independent
    // red, green, blue and alpha values, including transparent colored pixels.
    var ciTlgSource = new Layer(ciWindow, ciLayer);
    ciTlgSource.setSize(9, 10);
    ciTlgSource.imageWidth = 9;
    ciTlgSource.imageHeight = 10;
    ciTlgSource.type = ltAlpha;
    var ciTlgColors = [], ciTlgAlphas = [];
    for (var ciY = 0; ciY < 10; ++ciY) {
        for (var ciX = 0; ciX < 9; ++ciX) {
            var ciColor = ((32 + ciX * 7 + ciY) << 16) | ((64 + ciY * 9) << 8) | (128 + ciX + ciY * 3);
            var ciAlpha = (ciX * 37 + ciY * 19) & 255;
            ciTlgSource.setMainPixel(ciX, ciY, ciColor);
            ciTlgSource.setMaskPixel(ciX, ciY, ciAlpha);
            ciTlgColors.add(ciColor);
            ciTlgAlphas.add(ciAlpha);
        }
    }
    var ciTlgResult = new Layer(ciWindow, ciLayer);
    var ciTlgModes = ["tlg5", "tlg524", "tlg6", "tlg624"];
    for (var ciModeIndex = 0; ciModeIndex < ciTlgModes.count; ++ciModeIndex) {
        var ciMode = ciTlgModes[ciModeIndex];
        var ciTlgPath = ciStorage + "codec-" + ciMode + ".tlg";
        ciTlgSource.saveLayerImage(ciTlgPath, ciMode);
        ciTlgResult.loadImages(ciTlgPath);
        var ciTlgOK = ciTlgResult.imageWidth == 9 && ciTlgResult.imageHeight == 10;
        var ciTlgMismatch = "";
        for (var ciY = 0; ciY < 10 && ciTlgOK; ++ciY) {
            for (var ciX = 0; ciX < 9; ++ciX) {
                var ciPixelIndex = ciY * 9 + ciX;
                var ciExpectedAlpha = (ciModeIndex & 1) ? 255 : ciTlgAlphas[ciPixelIndex];
                if (ciTlgResult.getMainPixel(ciX, ciY) != ciTlgColors[ciPixelIndex]
                    || ciTlgResult.getMaskPixel(ciX, ciY) != ciExpectedAlpha) {
                    ciTlgOK = false;
                    ciTlgMismatch = " at " + ciX + "," + ciY + " rgb=" + ciTlgResult.getMainPixel(ciX, ciY)
                        + " alpha=" + ciTlgResult.getMaskPixel(ciX, ciY);
                    break;
                }
            }
        }
        ciCheck(ciTlgOK, ciMode + " save/load preserves color and alpha across blocks" + ciTlgMismatch);
    }
    ciCheck(ciTlgSource.getMainPixel(0, 0) == ciTlgColors[0] && ciTlgSource.getMaskPixel(0, 0) == 0,
        "TLG saving preserves the source image");
    invalidate ciTlgSource;
    invalidate ciTlgResult;

    Scripts.compileStorage(ciStorage + "compiled-startup-source.tjs", ciStorage + "startup.tjs");
    ciWindow.minimize();
    ciCheck(!ciWindow.visible, "window minimize");
    ciWindow.restore();
    ciCheck(ciWindow.visible, "window restore");
    ciMessages.add("ENGINE_CI_PASS");
} catch (error) {
    ciMessages.add("ENGINE_CI_FAIL " + ciErrorText(error));
}
ciMessages.save(ciOutput + "result.txt", "utf-8");
