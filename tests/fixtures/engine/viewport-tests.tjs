Scripts.execStorage(ciStorage + "layer-viewport.tjs");
var ciViewport = new LayerViewport(ciWindow, ciLayer, ciLayer);
ciCheck(ciViewport.root.type == ltAlpha && ciViewport.root.face == dfAlpha
    && ciViewport.snapshot.type == ltAlpha && ciViewport.snapshot.face == dfAlpha
    && ciViewport.display.type == ltAlpha && ciViewport.display.face == dfAlpha,
    "viewport defaults to straight alpha for source, snapshot, and display");
ciViewport.setSourceSize(16, 12);
ciViewport.setScreenRect(0, 0, 32, 24);
ciViewport.interpolation = stNearest;
var ciViewChild = new Layer(ciWindow, ciViewport.root);
ciViewChild.type = ltOpaque;
ciViewChild.setSize(8, 6);
ciViewChild.setImageSize(8, 6);
ciViewChild.fillRect(0, 0, 8, 6, 0xff123456);
ciViewChild.setPos(4, 3);
ciViewChild.visible = true;
ciViewport.render(true);
ciCheck(ciViewport.display.getMainPixel(10, 8) == 0x123456
    && ciViewport.display.getMaskPixel(1, 1) == 0,
    "viewport scales a hidden subtree and preserves transparent borders");
ciCheck(!ciViewport.root.cacheDirty, "viewport composition clears the cached update region");
ciViewport.display.visible = true;
ciCheck(!ciViewport.render() && ciViewport.renderedFrames == 1,
    "viewport skips unchanged cached frames");
ciViewport.snapshot.piledCopy(0, 0, ciViewport.root, 0, 0, 4, 4);
ciCheck(!ciViewport.root.cacheDirty,
    "partial piled copy preserves a previously completed source cache");
ciViewChild.fillRect(0, 0, 1, 1, 0xffabcdef);
ciCheck(ciViewport.root.cacheDirty, "pixel edit marks the cached source dirty");
ciViewport.snapshot.piledCopy(0, 0, ciViewport.root, 0, 0, 4, 3);
ciCheck(ciViewport.root.cacheDirty,
    "partial piled copy preserves pending edits outside its source rectangle");
ciViewport.snapshot.piledCopy(0, 0, ciViewport.root, 4, 3, 1, 1);
ciCheck(!ciViewport.root.cacheDirty && ciViewport.snapshot.getMainPixel(0, 0) == 0xabcdef,
    "partial piled copy completes only the edited source region");
ciViewChild.fillRect(0, 0, 8, 6, 0xff123456);
ciViewChild.setPos(1, 1);
ciCheck(ciViewport.root.cacheDirty, "child movement invalidates the viewport cache");
ciViewport.render();
ciCheck(ciViewport.display.getMainPixel(4, 4) == 0x123456
    && ciViewport.display.getMaskPixel(22, 16) == 0,
    "viewport movement updates new and old child locations");
ciViewport.setSourceSize(32, 24);
ciViewport.render();
ciCheck(ciViewport.display.getMainPixel(3, 3) == 0x123456
    && ciViewport.display.getMaskPixel(12, 10) == 0,
    "viewport switches to unscaled composition after zoom changes");
ciCheck(!ciViewport.root.cacheDirty && !ciViewport.render(),
    "growing the viewport source completes its cache and skips unchanged frames");

ciViewport.root.fillRect(24, 18, 1, 1, 0xffabcdef);
ciViewport.setSourceSize(16, 12);
ciCheck(ciViewport.root.cacheDirty && ciViewport.render()
    && !ciViewport.root.cacheDirty && !ciViewport.render(),
    "shrinking the source discards dirty regions outside its new image bounds");
ciViewport.setSourceSize(32, 24);
ciCheck(ciViewport.render() && !ciViewport.root.cacheDirty
    && ciViewport.display.getMaskPixel(24, 18) == 0,
    "growing a previously shrunk source initializes the newly exposed pixels");

ciViewport.root.fillRect(24, 18, 1, 1, 0xffabcdef);
ciViewport.root.setSize(16, 12);
ciViewport.snapshot.piledCopy(0, 0, ciViewport.root, 0, 0, 16, 12);
ciCheck(ciViewport.root.imageWidth == 32 && ciViewport.root.imageHeight == 24
    && !ciViewport.root.cacheDirty,
    "shrinking only the layer bounds discards out-of-bounds dirty regions");
ciViewport.root.setSize(32, 24);
ciCheck(ciViewport.root.cacheDirty,
    "growing the layer bounds invalidates its newly exposed cache area");
ciViewport.snapshot.piledCopy(0, 0, ciViewport.root, 0, 0, 32, 24);
ciCheck(!ciViewport.root.cacheDirty
    && ciViewport.snapshot.getMainPixel(24, 18) == 0xabcdef,
    "growing only the layer bounds preserves and recomposes its image pixels");
ciViewport.root.fillRect(24, 18, 1, 1, 0);
ciViewport.render(true);

ciViewChild.visible = false;
ciCheck(ciViewport.root.cacheDirty && ciViewport.render()
    && !ciViewport.root.cacheDirty && !ciViewport.render()
    && ciViewport.display.getMaskPixel(2, 2) == 0,
    "hiding the last visible child completes a transparent cache and skips unchanged frames");
ciViewChild.setPos(20, 14);
ciViewChild.visible = true;
ciCheck(ciViewport.render() && !ciViewport.root.cacheDirty
    && ciViewport.display.getMainPixel(22, 16) == 0x123456
    && ciViewport.display.getMaskPixel(2, 2) == 0,
    "showing the last child elsewhere leaves its old cached pixels cleared");
ciViewChild.setPos(1, 1);
ciViewport.setVisible(false);
var ciViewFrames = ciViewport.renderedFrames;
ciViewChild.fillRect(0, 0, 8, 6, 0xffabcdef);
ciCheck(!ciViewport.render() && ciViewport.renderedFrames == ciViewFrames,
    "hidden viewport stops frame composition");
ciViewport.render(true);
ciCheck(ciViewport.display.getMainPixel(3, 3) == 0xabcdef,
    "viewport captures changes accumulated while hidden");
invalidate ciViewChild;
ciViewport.display.visible = true;
ciViewport.root.fillRect(2, 2, 1, 1, 0xffabcdef);
ciCheck(ciViewport.render() && !ciViewport.root.cacheDirty
    && !ciViewport.render() && ciViewport.display.getMainPixel(2, 2) == 0xabcdef,
    "a childless cached source completes edits and skips unchanged frames");
invalidate ciViewport;

// A wholly synthetic premultiplied subtree: two pixels inside nested binders,
// surrounded by a transparent border. Raw RGB is already multiplied by alpha.
function ciCheckPremultViewportPixels(layer, scale, edited, label) {
    for (var y = 0; y < 3 * scale; ++y)
        for (var x = 0; x < 4 * scale; ++x) {
            var sx = Math.floor(x / scale), sy = Math.floor(y / scale);
            var expected = 0;
            if (sy == 1 && sx == 1) expected = 0xff123456;
            if (sy == 1 && sx == 2) expected = edited ? 0x80204030 : 0x80402010;
            var color = layer.getMainPixel(x, y), alpha = layer.getMaskPixel(x, y);
            if (color != (expected & 0xffffff) || alpha != ((expected >> 24) & 255))
                throw label + " changed RGBA at " + x + "," + y
                    + " rgb=" + color + " alpha=" + alpha;
        }
    ciCheck(true, label + " preserves every premultiplied RGBA pixel and transparent border");
}
var ciPremultBlack = new Layer(ciWindow, ciLayer);
ciPremultBlack.type = ltOpaque; ciPremultBlack.face = dfOpaque;
ciPremultBlack.holdAlpha = false; ciPremultBlack.visible = false;
ciPremultBlack.setSize(8, 6); ciPremultBlack.setImageSize(8, 6);
ciPremultBlack.fillRect(0, 0, 8, 6, 0xff000000);
var ciPremultView = new LayerViewport(ciWindow, ciLayer, ciPremultBlack, ltAddAlpha);
ciCheck(ciPremultView.root.type == ltAddAlpha && ciPremultView.root.face == dfAddAlpha
    && ciPremultView.snapshot.type == ltAddAlpha && ciPremultView.snapshot.face == dfAddAlpha
    && ciPremultView.display.type == ltAddAlpha && ciPremultView.display.face == dfAddAlpha,
    "viewport uses premultiplied alpha for source, snapshot, and display when requested");
ciPremultView.setSourceSize(4, 3);
ciPremultView.setScreenRect(0, 0, 4, 3);
// Keep the helper's default stFastLinear to exercise exact integer enlargement.
var ciPremultOuter = new Layer(ciWindow, ciPremultView.root);
ciPremultOuter.type = ltBinder; ciPremultOuter.setSize(4, 3); ciPremultOuter.visible = true;
var ciPremultInner = new Layer(ciWindow, ciPremultOuter);
ciPremultInner.type = ltBinder; ciPremultInner.setSize(2, 1);
ciPremultInner.setPos(1, 1); ciPremultInner.visible = true;
var ciPremultChild = new Layer(ciWindow, ciPremultInner);
ciPremultChild.type = ltAddAlpha; ciPremultChild.face = dfAddAlpha;
ciPremultChild.setSize(2, 1); ciPremultChild.setImageSize(2, 1);
ciPremultChild.fillRect(0, 0, 1, 1, 0xff123456);
ciPremultChild.fillRect(1, 0, 1, 1, 0x80402010);
ciPremultChild.visible = true;
ciCheck(ciPremultView.render(true), "premultiplied viewport composes a hidden nested subtree");
ciCheckPremultViewportPixels(ciPremultView.display, 1, false, "Unscaled viewport");

var ciPremultCapture = new Layer(ciWindow, ciLayer);
ciPremultCapture.type = ltAddAlpha; ciPremultCapture.face = dfAddAlpha;
ciPremultCapture.visible = false;
ciPremultCapture.setSize(8, 6); ciPremultCapture.setImageSize(8, 6);
var ciPremultScratch = new Layer(ciWindow, ciLayer);
ciPremultScratch.type = ltAddAlpha; ciPremultScratch.face = dfAddAlpha;
ciPremultScratch.visible = false;
ciCheck(ciPremultView.capture(ciPremultCapture, ciPremultScratch, 8, 6),
    "premultiplied viewport captures through caller-owned layers of the same format");
ciCheckPremultViewportPixels(ciPremultScratch, 1, false, "Capture snapshot");
ciCheckPremultViewportPixels(ciPremultCapture, 2, false, "2x capture");
ciPremultView.setScreenRect(0, 0, 8, 6);
ciPremultView.display.visible = true;
ciCheck(ciPremultView.render() && !ciPremultView.root.cacheDirty,
    "premultiplied viewport completes its cached source while scaling");
ciCheckPremultViewportPixels(ciPremultView.snapshot, 1, false, "Viewport snapshot");
ciCheckPremultViewportPixels(ciPremultView.display, 2, false, "2x viewport");
var ciPremultFrames = ciPremultView.renderedFrames;
ciCheck(!ciPremultView.render() && ciPremultView.renderedFrames == ciPremultFrames,
    "premultiplied viewport skips unchanged cached frames");

// Compose the visible display layer over an actual opaque parent. Pixel copies
// alone cannot detect a display layer that multiplies premultiplied RGB again.
ciPremultCapture.piledCopy(0, 0, ciPremultBlack, 0, 0, 8, 6);
for (var ciPremultY = 0; ciPremultY < 6; ++ciPremultY)
    for (var ciPremultX = 0; ciPremultX < 8; ++ciPremultX) {
        var ciPremultExpected = 0;
        if (ciPremultY >= 2 && ciPremultY < 4) {
            if (ciPremultX >= 2 && ciPremultX < 4) ciPremultExpected = 0x123456;
            if (ciPremultX >= 4 && ciPremultX < 6) ciPremultExpected = 0x402010;
        }
        if (ciPremultCapture.getMainPixel(ciPremultX, ciPremultY) != ciPremultExpected)
            throw "Premultiplied display over black changed RGB at " + ciPremultX + "," + ciPremultY;
    }
ciCheck(true, "premultiplied display composes over opaque black without multiplying alpha twice");
ciPremultChild.fillRect(1, 0, 1, 1, 0x80204030);
ciCheck(ciPremultView.root.cacheDirty && ciPremultView.render()
    && !ciPremultView.root.cacheDirty && ciPremultView.renderedFrames == ciPremultFrames + 1,
    "premultiplied child pixel edit invalidates and completes the nested viewport cache");
ciCheckPremultViewportPixels(ciPremultView.snapshot, 1, true, "Edited viewport snapshot");
ciCheckPremultViewportPixels(ciPremultView.display, 2, true, "Edited 2x viewport");
ciCheck(!ciPremultView.render() && ciPremultView.renderedFrames == ciPremultFrames + 1,
    "premultiplied viewport skips unchanged frames after a pixel edit");

// Capturing the source completes its cache without updating the displayed image.
// Exercise both direct shared-texture display and the scaled snapshot path.
for (var ciCaptureScale = 1; ciCaptureScale <= 2; ++ciCaptureScale) {
    ciPremultView.setScreenRect(0, 0, 4 * ciCaptureScale, 3 * ciCaptureScale);
    ciPremultChild.fillRect(1, 0, 1, 1, 0x80402010);
    ciCheck(ciPremultView.render(), "capture refresh establishes the previous displayed frame");
    ciCheckPremultViewportPixels(ciPremultView.display, ciCaptureScale, false,
        "Display before capture at " + ciCaptureScale + "x");
    var ciCaptureFrames = ciPremultView.renderedFrames;

    ciPremultChild.fillRect(1, 0, 1, 1, 0x80204030);
    ciCheck(ciPremultView.root.cacheDirty, "capture refresh starts with an unrendered child edit");
    ciPremultView.capture(ciPremultCapture, ciPremultScratch, 8, 6);
    ciCheck(!ciPremultView.root.cacheDirty && ciPremultView.renderedFrames == ciCaptureFrames,
        "capture completes the source cache without rendering the display");
    ciCheckPremultViewportPixels(ciPremultScratch, 1, true, "Updated capture scratch");
    ciCheckPremultViewportPixels(ciPremultCapture, 2, true, "Updated capture target");
    ciCheckPremultViewportPixels(ciPremultView.display, ciCaptureScale, false,
        "Retained display after capture at " + ciCaptureScale + "x");
    // A second capture sees a clean source and must preserve the pending refresh.
    ciPremultView.capture(ciPremultCapture, ciPremultScratch, 8, 6);
    ciCheck(ciPremultView.render() && ciPremultView.renderedFrames == ciCaptureFrames + 1
        && !ciPremultView.root.cacheDirty,
        "repeated captures preserve one display refresh without resizing or forcing");
    ciCheckPremultViewportPixels(ciPremultView.display, ciCaptureScale, true,
        "Display refreshed after capture at " + ciCaptureScale + "x");
    ciCheck(!ciPremultView.render() && ciPremultView.renderedFrames == ciCaptureFrames + 1,
        "unchanged frames are skipped after the capture refresh");

    // cacheDirty describes the source cache, not a per-reader generation. An
    // independent capture can clear it before this helper captures the source.
    ciPremultChild.fillRect(1, 0, 1, 1, 0x80402010);
    ciPremultScratch.piledCopy(0, 0, ciPremultView.root, 0, 0, 4, 3);
    ciCheck(!ciPremultView.root.cacheDirty, "another reader can complete the edited source cache");
    ciCheckPremultViewportPixels(ciPremultScratch, 1, false, "Independently captured pixels");
    ciCheckPremultViewportPixels(ciPremultView.display, ciCaptureScale, true,
        "Display retained after another reader completes the source");
    ciPremultView.capture(ciPremultCapture, ciPremultScratch, 8, 6);
    ciCheck(ciPremultView.render() && ciPremultView.renderedFrames == ciCaptureFrames + 2,
        "capture refreshes the display even when another reader already completed the source");
    ciCheckPremultViewportPixels(ciPremultCapture, 2, false, "Capture after an independent reader");
    ciCheckPremultViewportPixels(ciPremultView.display, ciCaptureScale, false,
        "Display refreshed after an independent reader");
    ciCheck(!ciPremultView.render() && ciPremultView.renderedFrames == ciCaptureFrames + 2,
        "display refresh resumes skipping after independently completed source pixels");
}
invalidate ciPremultChild;
invalidate ciPremultInner;
invalidate ciPremultOuter;
invalidate ciPremultCapture;
invalidate ciPremultScratch;
invalidate ciPremultView;
invalidate ciPremultBlack;
