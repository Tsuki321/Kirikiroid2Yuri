// Optional matched-release benchmark, injected by the loading benchmark driver.
// Uses only public APIs available in the baseline APK. Timings are diagnostic.
function ciRenderPattern(x, y) {
    var tx = Math.floor(x / 80), ty = Math.floor(y / 80);
    return 0xff000000 | (((tx * 17 + ty * 7) % 200 + 20) << 16) |
        (((tx * 11 + ty * 23) % 200 + 20) << 8) | ((tx * 29 + ty * 13) % 200 + 20);
}
function ciCheckRenderZoom(dest, width, height, label, marginX, marginY) {
    var samples = 0;
    // Tile interiors remain constant under nearest and linear interpolation.
    for (var ty = 1; ty <= 7; ty += 2) {
        for (var tx = 2; tx <= 14; tx += 3) {
            var sx = tx * 80 + 40, sy = ty * 80 + 40;
            var dx = Math.floor((sx - marginX) * width / (width - 2 * marginX));
            var dy = Math.floor((sy - marginY) * height / (height - 2 * marginY));
            if (dest.getMainPixel(dx, dy) != (ciRenderPattern(sx, sy) & 0xffffff) || dest.getMaskPixel(dx, dy) != 255)
                throw label + " changed a constant-color tile interior";
            ++samples;
        }
    }
    ciCheck(samples == 20, label + " preserves 20 independently predicted zoom samples");
}
function ciLinearRamp(x, y) {
    return [16 + 24 * x, 24 + 40 * y, 224 - 16 * x - 8 * y, 16 * x + 16 * y];
}
function ciCheckLinearPixel(layer, x, y, expected, tolerance, label) {
    var rgb = layer.getMainPixel(x, y);
    var actual = [(rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, layer.getMaskPixel(x, y)];
    for (var channel = 0; channel < 4; ++channel)
        if (Math.abs(actual[channel] - expected[channel]) > tolerance)
            throw label + " at " + x + "," + y + " channel " + channel +
                " expected " + expected[channel] + " got " + actual[channel];
}
function ciCheckLinearResize(window, primary) {
    // An affine RGBA ramp has an independent bilinear oracle at every pixel.
    // Alpha starts at zero with nonzero RGB, exposing accidental premultiplying
    // or compositing. These checks run outside the timed opaque zoom workload.
    var source = new Layer(window, primary), dest = new Layer(window, primary);
    source.setSize(7, 5); source.setImageSize(7, 5);
    dest.setSize(17, 16); dest.setImageSize(17, 16);
    var layers = [source, dest];
    for (var i = 0; i < layers.count; ++i) {
        layers[i].type = ltAlpha; layers[i].face = dfAlpha;
        layers[i].holdAlpha = false; layers[i].visible = false;
    }
    for (var y = 0; y < 5; ++y)
        for (var x = 0; x < 7; ++x) {
            var rgba = ciLinearRamp(x, y);
            source.fillRect(x, y, 1, 1, (rgba[3] << 24) | (rgba[0] << 16) | (rgba[1] << 8) | rgba[2]);
        }
    for (var affine = 0; affine < 2; ++affine) {
        dest.fillRect(0, 0, 17, 16, 0x7f315273);
        if (affine)
            dest.affineCopy(source, 0, 0, 7, 5, false, 3, 5, 14, 5, 3, 13, stLinear);
        else
            dest.stretchCopy(3, 5, 11, 8, source, 0, 0, 7, 5, stLinear);
        var label = affine ? "linear affineCopy" : "linear stretchCopy";
        for (var y = 0; y < 16; ++y)
            for (var x = 0; x < 17; ++x) {
                if (x < 3 || x >= 14 || y < 5 || y >= 13) {
                    ciCheckLinearPixel(dest, x, y, [49, 82, 115, 127], 0, label + " untouched margin");
                    continue;
                }
                // Pixel-center coordinates with source-edge replication.
                var sx = Math.max(0, Math.min(6, ((x - 3) + 0.5) * 7 / 11 - 0.5));
                var sy = Math.max(0, Math.min(4, ((y - 5) + 0.5) * 5 / 8 - 0.5));
                ciCheckLinearPixel(dest, x, y, ciLinearRamp(sx, sy), 1, label + " RGBA ramp");
            }
        for (var y = 0; y < 5; ++y)
            for (var x = 0; x < 7; ++x)
                ciCheckLinearPixel(source, x, y, ciLinearRamp(x, y), 0, label + " unchanged source");
        ciCheck(source.imageWidth == 7 && source.imageHeight == 5 &&
            dest.imageWidth == 17 && dest.imageHeight == 16,
            label + " preserves every ramp RGBA sample, transparent RGB, source and margins");
    }
}
function ciZoomBenchmark(dest, snapshot, width, height, frames, warmupFrames, filter) {
    var label = filter == stLinear ? "linear" : "fast-linear";
    for (var frame = 0; frame < warmupFrames; ++frame)
        dest.stretchCopy(0, 0, width, height, snapshot, 64, 36, width - 128, height - 72, filter);
    var started = System.getTickCount();
    for (var frame = 0; frame < frames; ++frame) {
        var marginX = 64 + (frame % 4) * 8, marginY = 36 + (frame % 4) * 4;
        dest.stretchCopy(0, 0, width, height, snapshot, marginX, marginY,
            width - 2 * marginX, height - 2 * marginY, filter);
    }
    var stretchTime = System.getTickCount() - started;
    ciCheckRenderZoom(dest, width, height, label + " stretchCopy", 88, 48);
    for (var frame = 0; frame < warmupFrames; ++frame)
        dest.affineCopy(snapshot, 64, 36, width - 128, height - 72, false, 0, 0, width, 0, 0, height, filter);
    started = System.getTickCount();
    for (var frame = 0; frame < frames; ++frame) {
        var marginX = 64 + (frame % 4) * 8, marginY = 36 + (frame % 4) * 4;
        // Axis-aligned scene zooms use the rectangle path.
        dest.affineCopy(snapshot, marginX, marginY, width - 2 * marginX, height - 2 * marginY,
            false, 0, 0, width, 0, 0, height, filter);
    }
    var affineTime = System.getTickCount() - started;
    ciCheckRenderZoom(dest, width, height, label + " affineCopy", 88, 48);
    return [stretchTime, affineTime];
}
function ciSnapshotBenchmark(window, primary, snapshot, width, height, frames, warmupFrames) {
    // The source is larger than the output so piledCopy must copy a rectangle,
    // rather than simply sharing the complete source texture. Visible children
    // require actual subtree composition even though the source is offscreen.
    var scene = new Layer(window, primary);
    scene.setSize(width + 64, height + 64); scene.setImageSize(width + 64, height + 64);
    scene.type = ltOpaque; scene.holdAlpha = false; scene.visible = false;
    scene.fillRect(0, 0, width + 64, height + 64, 0xff102030);
    var pieces = [];
    for (var i = 0; i < 6; ++i) {
        var piece = new Layer(window, scene);
        piece.setSize(320, 200); piece.setImageSize(320, 200);
        piece.setPos(64 + (i % 3) * 400, 64 + Math.floor(i / 3) * 280);
        piece.type = ltOpaque; piece.holdAlpha = false; piece.visible = true;
        piece.fillRect(0, 0, 320, 200, 0xff000000 | (0x203040 + i * 0x111111));
        pieces.add(piece);
    }
    var small = new Layer(window, scene);
    small.setSize(48, 32); small.setImageSize(48, 32); small.setPos(608, 640);
    small.type = ltOpaque; small.holdAlpha = false; small.visible = true;
    small.fillRect(0, 0, 48, 32, 0xffaa3300);
    scene.cached = true;
    for (var i = 0; i < warmupFrames; ++i) snapshot.piledCopy(0, 0, scene, 32, 32, width, height);
    var started = System.getTickCount();
    for (var i = 0; i < frames; ++i) snapshot.piledCopy(0, 0, scene, 32, 32, width, height);
    ciMessages.add("METRIC render_snapshot_unchanged_ms=" + (System.getTickCount() - started) + " frames=240 width=1280 height=720 children=7");
    for (var i = 0; i < 6; ++i) {
        var x = 64 + (i % 3) * 400 + 160 - 32, y = 64 + Math.floor(i / 3) * 280 + 100 - 32;
        if (snapshot.getMainPixel(x, y) != 0x203040 + i * 0x111111 || snapshot.getMaskPixel(x, y) != 255)
            throw "Partial cached snapshot lost a child";
    }
    ciCheck(snapshot.getMainPixel(0, 0) == 0x102030 && snapshot.getMainPixel(600, 620) == 0xaa3300,
        "partial cached snapshot preserves independently predicted background and children");
    for (var i = 0; i < warmupFrames; ++i) {
        small.fillRect(0, 0, 48, 32, i % 2 ? 0xff00cc77 : 0xffaa3300);
        snapshot.piledCopy(0, 0, scene, 32, 32, width, height);
    }
    started = System.getTickCount();
    for (var i = 0; i < frames; ++i) {
        small.fillRect(0, 0, 48, 32, i % 2 ? 0xff00cc77 : 0xffaa3300);
        snapshot.piledCopy(0, 0, scene, 32, 32, width, height);
    }
    ciMessages.add("METRIC render_snapshot_small_update_ms=" + (System.getTickCount() - started) + " frames=240 width=1280 height=720 dirty_width=48 dirty_height=32 children=7");
    ciCheck(snapshot.getMainPixel(600, 620) == 0x00cc77 && snapshot.getMaskPixel(600, 620) == 255 &&
        snapshot.getMainPixel(31, 620) == 0x102030 && snapshot.getMainPixel(192, 132) == 0x203040,
        "small cached child updates preserve the changed pixels and untouched scene");
    scene.cached = false;
}
function ciRenderingBenchmark() {
    var width = 1280, height = 720, frames = 240, warmupFrames = 24;
    var window = new Window(); window.setSize(width, height);
    var primary = new Layer(window, null);
    primary.setSize(width, height); primary.setImageSize(width, height);
    primary.type = ltOpaque; primary.holdAlpha = false; primary.visible = true;
    window.visible = true;
    for (var y = 0; y < height; y += 80)
        for (var x = 0; x < width; x += 80)
            primary.fillRect(x, y, 80, 80, ciRenderPattern(x, y));
    var snapshot = new Layer(window, primary), dest = new Layer(window, primary);
    var layers = [snapshot, dest];
    for (var i = 0; i < layers.count; ++i) {
        layers[i].setSize(width, height); layers[i].setImageSize(width, height);
        layers[i].type = ltOpaque; layers[i].holdAlpha = false; layers[i].visible = false;
    }
    ciSnapshotBenchmark(window, primary, snapshot, width, height, frames, warmupFrames);
    // Isolate resampling from subtree capture with the original tile pattern.
    snapshot.piledCopy(0, 0, primary, 0, 0, width, height);
    ciCheck(snapshot.getMainPixel(440, 280) == (ciRenderPattern(440, 280) & 0xffffff) &&
        snapshot.getMaskPixel(440, 280) == 255 &&
        snapshot.getMainPixel(1160, 600) == (ciRenderPattern(1160, 600) & 0xffffff) &&
        snapshot.getMaskPixel(1160, 600) == 255, "render benchmark snapshot preserves its original tile pattern");
    // Reverse kernel order in trial 2 for both APKs. Each kernel warms up with
    // the same images/crops before timing; the filter semantics remain distinct.
    var filters = ciStorage.indexOf("-2") >= 0 ? [stLinear, stFastLinear] : [stFastLinear, stLinear];
    var fastTimes, linearTimes;
    ciMessages.add("DETAIL zoom_filter_order=" + (filters[0] == stLinear ? "linear-first" : "fast-linear-first"));
    for (var i = 0; i < filters.count; ++i) {
        var times = ciZoomBenchmark(dest, snapshot, width, height, frames, warmupFrames, filters[i]);
        if (filters[i] == stLinear) linearTimes = times; else fastTimes = times;
    }
    ciMessages.add("METRIC render_stretch_copy_ms=" + fastTimes[0] + " frames=240 width=1280 height=720 filter=fast-linear");
    ciMessages.add("METRIC render_affine_copy_ms=" + fastTimes[1] + " frames=240 width=1280 height=720 filter=fast-linear");
    ciMessages.add("METRIC render_stretch_copy_linear_ms=" + linearTimes[0] + " frames=240 width=1280 height=720 filter=linear");
    ciMessages.add("METRIC render_affine_copy_linear_ms=" + linearTimes[1] + " frames=240 width=1280 height=720 filter=linear");
    ciCheckLinearResize(window, primary);

    // Direct writes must retain the temporary-image fallback when source and
    // destination overlap. A unique column pattern exposes overwritten reads.
    var alias = new Layer(window, primary);
    alias.setSize(64, 32); alias.setImageSize(64, 32);
    alias.type = ltOpaque; alias.holdAlpha = false; alias.visible = false;
    var original = [];
    for (var x = 0; x < 64; ++x) {
        var color = 0xff000000 | ((x * 3) << 16) | ((x * 2) << 8) | x;
        alias.fillRect(x, 0, 1, 32, color); original.add(color & 0xffffff);
    }
    alias.stretchCopy(4, 0, 60, 32, alias, 0, 0, 32, 32, stNearest);
    for (var x = 0; x < 64; ++x) {
        var sourceX = x < 4 ? x : Math.floor((x - 4) * 32 / 60);
        if (alias.getMainPixel(x, 16) != original[sourceX] || alias.getMaskPixel(x, 16) != 255)
            throw "Aliased stretchCopy overwrote source pixels";
    }
    ciCheck(true, "overlapping stretchCopy preserves every nearest-neighbor source sample");
    ciMessages.save(ciOutput + "progress.txt");
    window.visible = false;
}
ciRenderingBenchmark();
