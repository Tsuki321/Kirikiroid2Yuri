// Optional matched-release benchmark, injected by the loading benchmark driver.
// Uses only public APIs available in the baseline APK. Timings are diagnostic.
function ciRenderPattern(x, y) {
    var tx = Math.floor(x / 80), ty = Math.floor(y / 80);
    return 0xff000000 | (((tx * 17 + ty * 7) % 200 + 20) << 16) |
        (((tx * 11 + ty * 23) % 200 + 20) << 8) | ((tx * 29 + ty * 13) % 200 + 20);
}
function ciCheckRenderZoom(dest, width, height, label, marginX, marginY) {
    var samples = 0;
    // Tile interiors remain constant under nearest and linear interpolation.
    for (var ty = 1; ty <= 7; ty += 2) {
        for (var tx = 2; tx <= 14; tx += 3) {
            var sx = tx * 80 + 40, sy = ty * 80 + 40;
            var dx = Math.floor((sx - marginX) * width / (width - 2 * marginX));
            var dy = Math.floor((sy - marginY) * height / (height - 2 * marginY));
            if (dest.getMainPixel(dx, dy) != (ciRenderPattern(sx, sy) & 0xffffff) || dest.getMaskPixel(dx, dy) != 255)
                throw label + " changed a constant-color tile interior";
            ++samples;
        }
    }
    ciCheck(samples == 20, label + " preserves 20 independently predicted zoom samples");
}
function ciRenderingBenchmark() {
    var width = 1280, height = 720, frames = 240, warmupFrames = 24;
    var window = new Window(); window.setSize(width, height);
    var primary = new Layer(window, null);
    primary.setSize(width, height); primary.setImageSize(width, height);
    primary.type = ltOpaque; primary.holdAlpha = false; primary.visible = true;
    window.visible = true;
    for (var y = 0; y < height; y += 80)
        for (var x = 0; x < width; x += 80)
            primary.fillRect(x, y, 80, 80, ciRenderPattern(x, y));
    var snapshot = new Layer(window, primary), dest = new Layer(window, primary);
    var layers = [snapshot, dest];
    for (var i = 0; i < layers.count; ++i) {
        layers[i].setSize(width, height); layers[i].setImageSize(width, height);
        layers[i].type = ltOpaque; layers[i].holdAlpha = false; layers[i].visible = false;
    }
    // KAG zoom effects first capture a composited scene, then repeatedly scale
    // a cropped part of that snapshot. Keep the snapshot cost a separate metric.
    for (var i = 0; i < warmupFrames; ++i) snapshot.piledCopy(0, 0, primary, 0, 0, width, height);
    var started = System.getTickCount();
    for (var i = 0; i < frames; ++i) snapshot.piledCopy(0, 0, primary, 0, 0, width, height);
    ciMessages.add("METRIC render_snapshot_piled_copy_ms=" + (System.getTickCount() - started) + " frames=240 width=1280 height=720");
    ciCheck(snapshot.getMainPixel(440, 280) == (ciRenderPattern(440, 280) & 0xffffff) &&
        snapshot.getMaskPixel(440, 280) == 255 &&
        snapshot.getMainPixel(1160, 600) == (ciRenderPattern(1160, 600) & 0xffffff) &&
        snapshot.getMaskPixel(1160, 600) == 255, "render benchmark snapshot preserves its original tile pattern");
    for (var frame = 0; frame < warmupFrames; ++frame)
        dest.stretchCopy(0, 0, width, height, snapshot, 64, 36, width - 128, height - 72, stFastLinear);
    started = System.getTickCount();
    for (var frame = 0; frame < frames; ++frame) {
        var marginX = 64 + (frame % 4) * 8, marginY = 36 + (frame % 4) * 4;
        dest.stretchCopy(0, 0, width, height, snapshot, marginX, marginY,
            width - 2 * marginX, height - 2 * marginY, stFastLinear);
    }
    ciMessages.add("METRIC render_stretch_copy_ms=" + (System.getTickCount() - started) + " frames=240 width=1280 height=720 filter=fast-linear");
    ciCheckRenderZoom(dest, width, height, "stretchCopy", 88, 48);

    for (var frame = 0; frame < warmupFrames; ++frame)
        dest.affineCopy(snapshot, 64, 36, width - 128, height - 72, false, 0, 0, width, 0, 0, height, stFastLinear);
    started = System.getTickCount();
    for (var frame = 0; frame < frames; ++frame) {
        var marginX = 64 + (frame % 4) * 8, marginY = 36 + (frame % 4) * 4;
        // An axis-aligned destination quad exercises the same rectangle path
        // as ordinary scene zooms without the arbitrary-rotation fallback.
        dest.affineCopy(snapshot, marginX, marginY, width - 2 * marginX, height - 2 * marginY,
            false, 0, 0, width, 0, 0, height, stFastLinear);
    }
    ciMessages.add("METRIC render_affine_copy_ms=" + (System.getTickCount() - started) + " frames=240 width=1280 height=720 filter=fast-linear");
    ciCheckRenderZoom(dest, width, height, "affineCopy", 88, 48);

    // Direct writes must retain the temporary-image fallback when source and
    // destination overlap. A unique column pattern exposes overwritten reads.
    var alias = new Layer(window, primary);
    alias.setSize(64, 32); alias.setImageSize(64, 32);
    alias.type = ltOpaque; alias.holdAlpha = false; alias.visible = false;
    var original = [];
    for (var x = 0; x < 64; ++x) {
        var color = 0xff000000 | ((x * 3) << 16) | ((x * 2) << 8) | x;
        alias.fillRect(x, 0, 1, 32, color); original.add(color & 0xffffff);
    }
    alias.stretchCopy(4, 0, 60, 32, alias, 0, 0, 32, 32, stNearest);
    for (var x = 0; x < 64; ++x) {
        var sourceX = x < 4 ? x : Math.floor((x - 4) * 32 / 60);
        if (alias.getMainPixel(x, 16) != original[sourceX] || alias.getMaskPixel(x, 16) != 255)
            throw "Aliased stretchCopy overwrote source pixels";
    }
    ciCheck(true, "overlapping stretchCopy preserves every nearest-neighbor source sample");
    ciMessages.save(ciOutput + "progress.txt");
    window.visible = false;
}
ciRenderingBenchmark();
